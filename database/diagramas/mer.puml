@startuml mer
' ConektaFinance - Modelo Entidade-Relacionamento (conceitual)
' Entidades e cardinalidades, sem tipos fisicos.
' Notacao: retangulos = entidades; elipses = relacionamentos, com cardinalidades nas pontas.

skinparam backgroundColor white
skinparam defaultFontName Arial
skinparam defaultFontSize 12
skinparam shadowing false
top to bottom direction
skinparam nodesep 60
skinparam ranksep 50

rectangle "USUÁRIO" as U
rectangle "CATEGORIA" as C
rectangle "ORÇAMENTO" as O
rectangle "LANÇAMENTO" as L
rectangle "ALERTA" as A
rectangle "MENSAGEM DO\nASSISTENTE" as M
rectangle "LOTE DE\nIMPORTAÇÃO" as I
rectangle "CÓDIGO OTP" as T
rectangle "FECHAMENTO\nMENSAL" as F
rectangle "REGISTRO DE\nAUDITORIA" as R

usecase "possui" as r1
usecase "define" as r2
usecase "limita" as r3
usecase "registra" as r4
usecase "classifica" as r5
usecase "recebe" as r6
usecase "refere-se a" as r7
usecase "conversa" as r8
usecase "importa" as r9
usecase "origina" as r10
usecase "solicita" as r11
usecase "consolida" as r12
usecase "maior gasto" as r13
usecase "audita" as r14

U "1" -- r1
r1 -- "N" C
U "1" -- r2
r2 -- "N" O
C "1" -- r3
r3 -- "N" O
U "1" -- r4
r4 -- "N" L
C "1" -- r5
r5 -- "N" L
U "1" -- r6
r6 -- "N" A
C "0..1" -- r7
r7 -- "N" A
U "1" -- r8
r8 -- "N" M
U "1" -- r9
r9 -- "N" I
I "0..1" -- r10
r10 -- "N" L
U "0..1" -- r11
r11 -- "N" T
U "1" -- r12
r12 -- "N" F
C "0..1" -- r13
r13 -- "N" F
L "1" -- r14
r14 -- "N" R

@enduml
