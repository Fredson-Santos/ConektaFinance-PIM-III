JWT_SECRET=troque-por-uma-chave-aleatoria-de-no-minimo-32-caracteres
ASPNETCORE_ENVIRONMENT=Production
ConnectionStrings__DefaultConnection=Data Source=/app/data/financeiro.db
Cors__AllowedOrigins__0=http://localhost:9001
Storage__UploadsPath=/app/wwwroot/uploads

# Agente de IA (API NVIDIA NIM — compatível com OpenAI, chave gratuita em build.nvidia.com)
Copilot__BaseUrl=https://integrate.api.nvidia.com/v1
Copilot__Model=nvidia/nemotron-3.5-lightning-30b-a3b
Copilot__VisionModel=nvidia/nemotron-3.5-super-vl-120b-a12b
Copilot__ApiKey=
Copilot__DailyMessageLimit=30
Copilot__MaxToolIterations=4
Copilot__HistoryWindowSize=12
Copilot__RequestTimeoutSeconds=120
