JWT_SECRET=troque-por-uma-chave-aleatoria-de-no-minimo-32-caracteres
ASPNETCORE_ENVIRONMENT=Production

# Banco da aplicacao (PostgreSQL). No Docker a connection string e montada pelo
# docker-compose.yml a partir destas variaveis; fora do Docker (dotnet run) use a
# linha ConnectionStrings__DefaultConnection apontando para a porta 5433 publicada.
CONEKTA_POSTGRES_DB=conektafinance
CONEKTA_POSTGRES_USER=conekta
CONEKTA_POSTGRES_PASSWORD=
# ConnectionStrings__DefaultConnection=Host=localhost;Port=5433;Database=conektafinance;Username=conekta;Password=
Cors__AllowedOrigins__0=http://localhost:9001

# Administrador do painel /admin (criado ou promovido no startup). Deixe em branco para nao criar.
Admin__Email=
Admin__Password=
Storage__UploadsPath=/app/wwwroot/uploads

# Agente de IA (API NVIDIA NIM — compatível com OpenAI, chave gratuita em build.nvidia.com)
Copilot__BaseUrl=https://integrate.api.nvidia.com/v1
Copilot__Model=nvidia/nemotron-3.5-lightning-30b-a3b
Copilot__VisionModel=nvidia/nemotron-3.5-super-vl-120b-a12b
Copilot__ApiKey=
Copilot__DailyMessageLimit=30
Copilot__MaxToolIterations=4
Copilot__HistoryWindowSize=12
Copilot__RequestTimeoutSeconds=120

# Canal WhatsApp (Evolution API v2 — docker-compose.yml: evolution + postgres + redis)
# Gere chaves fortes (ex.: dois GUIDs concatenados) e nunca comite valores reais.
EVOLUTION_API_KEY=
# Mesma chave de EVOLUTION_API_KEY — usada pelo backend para chamar a Evolution:
Evolution__ApiKey=
Evolution__BaseUrl=http://evolution:8080
Evolution__Instance=conekta
Evolution__WebhookToken=
Evolution__SendDelayMs=800
EVOLUTION_SERVER_URL=http://localhost:8082
EVOLUTION_POSTGRES_USER=evolution
EVOLUTION_POSTGRES_PASSWORD=
EVOLUTION_POSTGRES_DB=evolution
